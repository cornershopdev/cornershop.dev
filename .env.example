# Public application and routing
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave empty: the app is single-origin and serves its own /api/*. Setting this
# proxies every API request away, and on a single-origin host it loops forever.
CORNERSHOPDEV_API_ORIGIN=
PLATFORM_HOSTNAMES=localhost,cornershop.dev,www.cornershop.dev,api.cornershop.dev,domains.cornershop.dev
PUBLIC_APP_IP=
CUSTOM_DOMAIN_CNAME=domains.cornershop.dev

# PostgreSQL / Prisma 7. Never reuse production credentials locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cornershopdev?schema=public

# OpenRouter is the only model provider: structured text generation, model
# routing, and optional image enhancement all run through this one key.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openrouter/auto
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Photo subsystem policy. Values are micro-US-dollars (1,000,000 = $1).
PHOTO_ENHANCEMENT_MODEL=google/gemini-3.1-flash-image
PHOTO_DISCOVERY_MAX_IMAGES=8
PHOTO_INGEST_CONCURRENCY=4
PHOTO_ENHANCEMENT_CONCURRENCY=2
PHOTO_ENHANCEMENT_BATCH_MAX_IMAGES=6
PHOTO_ENHANCEMENT_ESTIMATED_COST_MICROS=25000
PHOTO_ENHANCEMENT_PER_IMAGE_CEILING_MICROS=50000
PHOTO_ENHANCEMENT_PER_SITE_CEILING_MICROS=500000

# Durable self-hosted import workflows
WORKFLOW_ENABLED=false
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/cornershopdev?schema=public
WORKFLOW_POSTGRES_JOB_PREFIX=cornershopdev_
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=2
WORKFLOW_POSTGRES_MAX_POOL_SIZE=4

# Public preview rate limiting
REDIS_URL=redis://localhost:6379

# Persistent image storage
AWS_REGION=us-west-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=https://assets.cornershop.dev

# Authenticates external readiness probes. Generate at least 32 random bytes.
HEALTHCHECK_TOKEN=

# Laptop-to-API prospect ingest for `bun run leads:discover --execute`.
# Distinct from HEALTHCHECK_TOKEN. Generate at least 32 random bytes.
OPERATOR_LEAD_INGEST_TOKEN=

# Google Places API (New) key for local lead discovery. Production discovery
# requires this or an explicitly approved non-public Nominatim-compatible host.
GOOGLE_PLACES_API_KEY=
# Commercial or self-hosted Nominatim-compatible search endpoint. The public
# nominatim.openstreetmap.org service is rejected for systematic lead discovery.
LEAD_DISCOVERY_NOMINATIM_BASE_URL=

# Stripe subscriptions. Test and live modes have separate keys, prices,
# Customer Portal configuration, webhook endpoints, and signing secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The public offer is one active, non-metered, tax-exclusive Stripe Price:
# EUR 49.00 every month. Stripe Checkout presents local currency automatically.
STRIPE_PRICE_ID=

# Claim links and email delivery. Checkout requires a hashed ClaimInvitation;
# the public claim URL alone never authorizes a purchase.
CLAIM_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Exact legal entity whose written-consent or soft-opt-in evidence authorizes
# the configured niche sender. Evidence for any other controller is rejected.
OUTREACH_LEGAL_CONTROLLER=Corner Shop Labs Ltd
# Better Auth session signing. Production requires a dedicated secret distinct
# from CLAIM_TOKEN_SECRET; development alone may use the fallback.
BETTER_AUTH_SECRET=replace-with-a-different-32-character-random-secret
# Comma-separated platform operators. Access also requires User.platformRole =
# SUPERADMIN in PostgreSQL; either gate alone is insufficient.
SUPERADMIN_EMAILS=
RESEND_API_KEY=
# Svix-compatible signing secret from the enabled Resend delivery webhook.
RESEND_WEBHOOK_SECRET=
# Distinct Svix-compatible signing secret from the inbound reply webhook.
RESEND_INBOUND_WEBHOOK_SECRET=
# Optional, default-off read-copy destination for matched inbound outreach.
# Set exactly one bare operator address outside every niche receiving domain.
OUTREACH_INBOUND_FORWARD_TO=
# Comma-separated operator incident recipients. Values are never returned by
# readiness or stored in alert rows.
OPERATOR_ALERT_EMAILS=
# Base64-encoded Ed25519 SPKI public key. Its private counterpart stays with the
# evidence custodian and never enters the application or deployment environment.
FIRST_CUSTOMER_EVIDENCE_PUBLIC_KEY=
# The floor, not the identity. A launched niche declares its own sender in
# `src/lib/verticals/<niche>/marketing.ts` and that always wins — these two only
# cover a niche with no verified sending domain of its own yet.
EMAIL_FROM=Vincent from Cornershopdev <vincent@send.cornershop.dev>
# Where a reply lands when the fallback above was used. Leave unset and the
# header is simply omitted.
EMAIL_REPLY_TO=vincent@cornershop.dev

# Product analytics on the public factory funnel only; customer storefronts are
# never instrumented. Leave the key unset and the pixel is a complete no-op, so
# a fork or a local checkout needs no PostHog project at all. The host defaults
# to the EU cloud; set it to a reverse-proxy origin to serve ingestion first-party.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
