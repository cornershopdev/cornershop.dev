generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Vertical {
  RESTAURANT
  BEAUTY
  LOCAL_SERVICE
  FOOD_RETAIL
}

enum SiteStatus {
  PROSPECT
  PREVIEW_READY
  CLAIMED
  LIVE
  PAUSED
}

enum DomainTlsStatus {
  PENDING
  READY
  ERROR
}

enum BookingRequestStatus {
  NEW
  NOTIFIED
  CONTACTED
  CLOSED
}

enum ImportStatus {
  QUEUED
  CRAWLING
  EXTRACTING
  GENERATING
  READY
  FAILED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum ArticleBatchStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  ZERO_OUTPUT
  REJECTED
  SKIPPED
  FAILED
}

enum IntegrationType {
  BOOKING
  ORDERING
  DELIVERY
  SOCIAL
  QUOTE
  CONTACT
  ANALYTICS
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ImageProvenance {
  OFFICIAL
  OWNER
  PERMISSIONED_UGC
}

enum PhotoSourceKind {
  FIRST_PARTY
  OWNER_REFERENCE
  OWNER_UPLOAD
}

enum PhotoReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PhotoUsage {
  HERO
  GALLERY
  CATALOG
}

enum PhotoActiveVariant {
  ORIGINAL
  ENHANCED
}

enum PhotoEnhancementStatus {
  NOT_REQUESTED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum AnalyticsEventType {
  SITE_VIEW
  CTA_CLICK
  LEAD_CREATED
}

enum OperatorAlertKind {
  CHECKOUT_WEBHOOK_FAILURE
  PUBLISH_FAILURE
  PUBLIC_SITE_HEALTH_FAILURE
  OUTREACH_SEND_FAILURE
  OUTREACH_REPLY
}

enum OperatorAlertStatus {
  PENDING
  DELIVERED
  EXHAUSTED
}

enum ClaimProofMethod {
  DOMAIN_EMAIL
  OPERATOR_APPROVAL
}

enum OutreachDirection {
  OUTBOUND
  INBOUND
}

enum OutreachStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  RECEIVED
}

enum OutreachInboundForwardStatus {
  PENDING
  SENT
  EXHAUSTED
}

enum OutreachInboundForwardDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
}

enum AuthLinkDestination {
  ADMIN
  WORKSPACE
}

enum AuthDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  SUPPRESSED
  FAILED
}

enum ClaimDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  SUPPRESSED
  FAILED
}

enum AuthSessionPurpose {
  ADMIN
  WORKSPACE_SELECTION
  SITE
}

enum SourceMonitorRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum SourceMonitorSuggestionField {
  MENU
  CONTACT
  HOURS
  LINKS
}

enum SourceMonitorSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                       String          @id @default(cuid())
  email                    String          @unique
  emailVerified            Boolean         @default(false)
  name                     String
  image                    String?
  platformRole             PlatformRole    @default(USER)
  authLinkSequence         Int             @default(0)
  authLinkActiveGeneration Int             @default(0)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  memberships              Membership[]
  sessions                 Session[]
  accounts                 Account[]
  authMagicLinks           AuthMagicLink[]
  authSessions             AuthSession[]
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  sites         Site[]
  subscriptions Subscription[]
  sessions      Session[]
  authSessions  AuthSession[]
}

model Membership {
  id             String       @id @default(cuid())
  role           String       @default("owner")
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Site {
  id                       String                    @id @default(cuid())
  slug                     String                    @unique
  name                     String
  eyebrow                  String?
  description              String?
  address                  String?
  phone                    String?
  email                    String?
  /// Private operator-reviewed owner/outreach recipient. Never project this
  /// field into a draft, published version, or public site response.
  leadContactEmail         String?
  sourceUrl                String?
  sourceKey                String?                   @unique
  logoUrl                  String?
  faviconUrl               String?
  sourceData               Json                      @default("{}")
  heroImageUrl             String?
  heroOriginalImageUrl     String?
  heroImageProvenance      ImageProvenance?
  autoEnhanceImages        Boolean                   @default(true)
  defaultLocale            String                    @default("en")
  translations             Json                      @default("[]")
  businessHours            Json                      @default("[]")
  draftTheme               Json                      @default("{}")
  draftThemeVersion        String                    @default("legacy-v1")
  draftPalette             Json                      @default("{}")
  vertical                 Vertical                  @default(RESTAURANT)
  attributes               Json                      @default("{}")
  draftRevision            Int                       @default(0)
  status                   SiteStatus                @default(PROSPECT)
  publishedSiteVersionId   String?                   @unique
  publishedSiteVersion     SiteVersion?              @relation("PublishedSiteVersion", fields: [publishedSiteVersionId], references: [id], onDelete: SetNull)
  organizationId           String?
  organization             Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  catalogSections          CatalogSection[]
  integrations             Integration[]
  importJobs               ImportJob[]
  domains                  Domain[]
  siteVersions             SiteVersion[]
  claimInvitations         ClaimInvitation[]
  outreachMessages         OutreachMessage[]
  outreachDispatches       OutreachDispatch[]
  subscription             Subscription?
  auditEvents              AuditEvent[]
  bookingRequests          BookingRequest[]
  analyticsEvents          AnalyticsEvent[]
  sessions                 Session[]
  authSessions             AuthSession[]
  sourceMonitorState       SourceMonitorState?
  sourceMonitorRuns        SourceMonitorRun[]
  sourceMonitorSuggestions SourceMonitorSuggestion[]
  photos                   PhotoAsset[]
  photoEnhancementRuns     PhotoEnhancementRun[]
  articles                 Article[]
  articleBatches           ArticleBatch[]
}

/// One locally relevant, indexable page for a claimed site. Articles are
/// generated in batches from the site's own facts (catalog, location, hours)
/// so content stays specific; nothing here may assert a fact the site does
/// not carry. Published articles render on the customer's live surfaces.
model Article {
  id               String        @id @default(cuid())
  siteId           String
  site             Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  batchId          String?
  batch            ArticleBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  slug             String
  locale           String
  title            String
  excerpt          String
  bodyMarkdown     String
  status           ArticleStatus @default(DRAFT)
  publishedAt      DateTime?
  publishedBy      String?
  /// Stable key naming which topic slot this fills (e.g. `seasonal-menu`),
  /// used to avoid repeating topics across consecutive batches per site.
  topicKey         String
  topicTitle       String
  generatedByModel String?
  sourceBatchId    String?
  unpublishReason  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, status, publishedAt])
  @@index([siteId, topicKey, createdAt])
}

/// One generation run against one site. Exists so an operator can see what
/// produced an article set and so dedupe checks can read "what did the last
/// batch cover" without scanning every article ever generated.
model ArticleBatch {
  id                 String             @id @default(cuid())
  siteId             String
  site               Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  requestedCount     Int
  acceptedCount      Int                @default(0) @map("producedCount")
  rejectedCount      Int                @default(0)
  status             ArticleBatchStatus @default(QUEUED)
  statusReason       String?
  model              String?
  workflowRunId      String?            @unique
  dispatchLeaseToken String?
  dispatchLeaseUntil DateTime?
  requestedBy        String
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  articles Article[]
  /// Backed by a partial unique index in
  /// 20260823110000_article_batch_admission_outcomes so every site has at most
  /// one QUEUED or RUNNING batch.

  @@index([siteId, createdAt])
  @@index([siteId, status, createdAt])
  @@index([status, workflowRunId, dispatchLeaseUntil, createdAt], map: "ArticleBatch_dispatch_queue_idx")
}

model PhotoAsset {
  id                       String                 @id @default(cuid())
  siteId                   String
  site                     Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sourceUrl                String
  sourcePageUrl            String?
  provenance               ImageProvenance
  sourceKind               PhotoSourceKind
  contentSha256            String
  originalStorageKey       String
  originalUrl              String
  mediaType                String
  byteLength               Int
  width                    Int?
  height                   Int?
  candidateUsages          PhotoUsage[]
  reviewStatus             PhotoReviewStatus      @default(PENDING)
  /// A partial unique index in 20260820230000_photo_selection_invariants
  /// permits at most one selected HERO per site.
  selectedUsage            PhotoUsage?
  selectedCatalogItemId    String?                @unique
  selectedCatalogItem      CatalogItem?           @relation(fields: [selectedCatalogItemId], references: [id], onDelete: SetNull)
  activeVariant            PhotoActiveVariant     @default(ORIGINAL)
  enhancedUrl              String?
  enhancedStorageKey       String?
  enhancedReviewStatus     PhotoReviewStatus?
  enhancementStatus        PhotoEnhancementStatus @default(NOT_REQUESTED)
  enhancementModel         String?
  enhancementConfigVersion String?
  enhancementCostMicros    Int?
  reviewedAt               DateTime?
  reviewedBy               String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  enhancementRuns          PhotoEnhancementRun[]

  @@unique([siteId, contentSha256])
  @@index([siteId, reviewStatus, createdAt])
  @@index([siteId, selectedUsage])
}

model PhotoEnhancementRun {
  id                  String                 @id @default(cuid())
  siteId              String
  site                Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  photoId             String
  photo               PhotoAsset             @relation(fields: [photoId], references: [id], onDelete: Cascade)
  idempotencyKey      String                 @unique
  status              PhotoEnhancementStatus @default(QUEUED)
  model               String
  configVersion       String
  estimatedCostMicros Int
  actualCostMicros    Int?
  requestedBy         String
  errorCode           String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([siteId, status, createdAt])
  @@index([photoId, createdAt])
}

model AuthMagicLink {
  id                 String              @id @default(cuid())
  tokenHash          String              @unique
  destination        AuthLinkDestination
  brandVertical      Vertical?
  deliveryStatus     AuthDeliveryStatus  @default(PENDING)
  deliveryAttempts   Int                 @default(0)
  retryCount         Int                 @default(0)
  rotationGeneration Int
  providerMessageId  String?
  providerEventAt    DateTime?
  failureCode        String?
  expiresAt          DateTime
  deliveredAt        DateTime?
  lastAttemptAt      DateTime?
  consumedAt         DateTime?
  revokedAt          DateTime?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerEvents     AuthProviderEvent[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, rotationGeneration])
  @@index([userId, createdAt])
  @@index([deliveryStatus, createdAt])
}

model AuthProviderEvent {
  id                String             @id
  authMagicLinkId   String
  authMagicLink     AuthMagicLink      @relation(fields: [authMagicLinkId], references: [id], onDelete: Cascade)
  providerMessageId String
  eventType         String
  deliveryStatus    AuthDeliveryStatus
  occurredAt        DateTime
  createdAt         DateTime           @default(now())

  @@index([authMagicLinkId, occurredAt])
  @@index([providerMessageId, occurredAt])
}

model AuthSession {
  id             String             @id @default(cuid())
  tokenHash      String             @unique
  purpose        AuthSessionPurpose
  expiresAt      DateTime
  revokedAt      DateTime?
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId, expiresAt])
  @@index([siteId, expiresAt])
}

model AuthEvent {
  id            String   @id @default(cuid())
  type          String
  actor         String?
  subjectUserId String?
  magicLinkId   String?
  sessionId     String?
  siteId        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([subjectUserId, createdAt])
  @@index([magicLinkId, createdAt])
  @@index([sessionId, createdAt])
}

model Session {
  id             String        @id
  expiresAt      DateTime
  token          String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ipAddress      String?
  userAgent      String?
  purpose        String        @default("WORKSPACE_SELECTION")
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([siteId, expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model CatalogSection {
  id          String        @id @default(cuid())
  name        String
  description String?
  position    Int           @default(0)
  siteId      String
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items       CatalogItem[]
}

model CatalogItem {
  id               String           @id @default(cuid())
  name             String
  description      String?
  price            Decimal?         @db.Decimal(10, 2)
  currency         String           @default("EUR")
  imageUrl         String?
  originalImageUrl String?
  imageProvenance  ImageProvenance?
  attributes       Json             @default("{}")
  /// Null means the source made no availability claim.
  available        Boolean?
  position         Int              @default(0)
  sectionId        String
  section          CatalogSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  selectedPhoto    PhotoAsset?
}

model Integration {
  id        String          @id @default(cuid())
  type      IntegrationType
  provider  String?
  label     String
  url       String
  position  Int             @default(0)
  /// Owner's id inside the provider (an OpenTable `rid`). Only consumed after the
  /// provider's own anchored `idPattern` matches it — see `src/lib/booking-embed.ts`.
  venueId   String?
  enabled   Boolean         @default(true)
  siteId    String
  site      Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([siteId, position])
}

model ImportJob {
  id            String       @id @default(cuid())
  status        ImportStatus @default(QUEUED)
  source        String
  sourceKey     String?
  workflowRunId String?
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  vertical      Vertical     @default(RESTAURANT)
  siteId        String?
  site          Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([sourceKey, createdAt])
}

model SiteVersion {
  id               String    @id @default(cuid())
  version          Int
  vertical         Vertical  @default(RESTAURANT)
  theme            Json
  themeVersion     String    @default("legacy-v1")
  palette          Json      @default("{}")
  content          Json
  translations     Json      @default("[]")
  integrations     Json      @default("[]")
  publishedAt      DateTime?
  publishedBy      String?
  changeSummary    String?
  siteId           String
  site             Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  publishedForSite Site?     @relation("PublishedSiteVersion")
  createdAt        DateTime  @default(now())

  @@unique([siteId, version])
}

model Domain {
  id                String          @id @default(cuid())
  hostname          String          @unique
  verified          Boolean         @default(false)
  verificationToken String          @unique
  verifiedAt        DateTime?
  tlsStatus         DomainTlsStatus @default(PENDING)
  tlsCheckedAt      DateTime?
  tlsFailureCode    String?
  siteId            String
  site              Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ClaimInvitation {
  id                      String               @id @default(cuid())
  email                   String
  tokenHash               String               @unique
  outreachKey             String?              @unique
  proofMethod             ClaimProofMethod     @default(DOMAIN_EMAIL)
  approvalEvidenceRef     String?
  approvedBy              String?
  approvedAt              DateTime?
  deliveryStatus          ClaimDeliveryStatus  @default(PENDING)
  deliveryAttempts        Int                  @default(0)
  retryCount              Int                  @default(0)
  replacesInvitationId    String?              @unique
  providerMessageId       String?              @unique
  providerEventAt         DateTime?
  deliveryFailureCode     String?
  deliveredAt             DateTime?
  lastDeliveryAttemptAt   DateTime?
  expiresAt               DateTime
  verifiedAt              DateTime?
  acceptedAt              DateTime?
  revokedAt               DateTime?
  checkoutSessionId       String?              @unique
  stripePriceId           String?
  checkoutAttempt         Int                  @default(0)
  checkoutReturnTokenHash String?
  checkoutReturnExpiresAt DateTime?
  siteId                  String
  site                    Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  providerEvents          ClaimProviderEvent[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([siteId, email, expiresAt])
  @@index([deliveryStatus, createdAt])
}

model ClaimProviderEvent {
  id                String              @id
  claimInvitationId String
  claimInvitation   ClaimInvitation     @relation(fields: [claimInvitationId], references: [id], onDelete: Cascade)
  providerMessageId String
  eventType         String
  deliveryStatus    ClaimDeliveryStatus
  occurredAt        DateTime
  createdAt         DateTime            @default(now())

  @@index([claimInvitationId, occurredAt])
  @@index([providerMessageId, occurredAt])
}

model OutreachMessage {
  id                     String                  @id @default(cuid())
  idempotencyKey         String                  @unique @default(dbgenerated("'legacy:' || gen_random_uuid()::text"))
  siteId                 String
  site                   Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  direction              OutreachDirection       @default(OUTBOUND)
  provider               String                  @default("resend")
  providerMessageId      String?                 @unique
  rfcMessageId           String?                 @unique
  fromAddress            String
  replyToAddress         String?
  toAddress              String
  subject                String
  textBody               String                  @db.Text
  htmlBody               String?                 @db.Text
  template               String?
  inReplyTo              String?
  threadKey              String?
  createdByActor         String?
  status                 OutreachStatus          @default(QUEUED)
  error                  String?
  sentAt                 DateTime?
  deliveredAt            DateTime?
  receivedAt             DateTime?
  providerEventAt        DateTime?
  providerAttemptedAt    DateTime?
  deliveryLeaseId        String?
  deliveryLeaseExpiresAt DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  providerEvents         OutreachProviderEvent[]
  inboundForward         OutreachInboundForward?

  @@index([siteId, createdAt])
  @@index([threadKey, createdAt])
  @@index([siteId, direction, createdAt])
}

model OutreachInboundForward {
  id                     String                               @id @default(cuid())
  outreachMessageId      String                               @unique
  outreachMessage        OutreachMessage                      @relation(fields: [outreachMessageId], references: [id], onDelete: Cascade)
  idempotencyKey         String                               @unique
  targetAddress          String?
  senderAddress          String
  siteName               String
  siteSlug               String
  status                 OutreachInboundForwardStatus         @default(PENDING)
  deliveryStatus         OutreachInboundForwardDeliveryStatus @default(PENDING)
  attempts               Int                                  @default(0)
  nextAttemptAt          DateTime                             @default(now())
  deliveryLeaseUntil     DateTime?
  deliveryLeaseToken     String?
  firstProviderAttemptAt DateTime?
  sentAt                 DateTime?
  deliveredAt            DateTime?
  providerMessageId      String?                              @unique
  providerEventAt        DateTime?
  lastFailureCode        String?
  deliveryFailureCode    String?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  providerEvents         OutreachForwardProviderEvent[]

  @@index([status, nextAttemptAt])
}

model OutreachForwardProviderEvent {
  id                String                               @id
  forwardId         String
  forward           OutreachInboundForward               @relation(fields: [forwardId], references: [id], onDelete: Cascade)
  providerMessageId String
  eventType         String
  deliveryStatus    OutreachInboundForwardDeliveryStatus
  occurredAt        DateTime
  createdAt         DateTime                             @default(now())

  @@index([forwardId, occurredAt])
  @@index([providerMessageId, occurredAt], map: "OutreachForwardEvent_providerMessageId_occurredAt_idx")
}

model OutreachDispatch {
  id             String         @id @default(cuid())
  idempotencyKey String         @unique
  siteId         String
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  template       String
  recipient      String
  reviewedAt     DateTime
  status         OutreachStatus @default(QUEUED)
  workflowRunId  String?        @unique
  requestedBy    String
  attempt        Int            @default(1)
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([siteId, createdAt])
}

model OutreachProviderEvent {
  id                String          @id
  outreachMessageId String
  outreachMessage   OutreachMessage @relation(fields: [outreachMessageId], references: [id], onDelete: Cascade)
  providerMessageId String
  eventType         String
  status            OutreachStatus
  occurredAt        DateTime
  createdAt         DateTime        @default(now())

  @@index([outreachMessageId, occurredAt])
  @@index([providerMessageId, occurredAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  stripeCustomerId     String
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  lastStripeEventAt    DateTime?
  siteId               String             @unique
  site                 Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([stripeCustomerId])
}

model StripeWebhookEvent {
  eventId         String   @id
  type            String
  livemode        Boolean?
  stripeCreatedAt DateTime
  status          String   @default("PROCESSED")
  failureReason   String?
  processedAt     DateTime @default(now())
}

/**
 * Minimal key-value store for operator-controlled global switches. The
 * outreach kill switch (`outreach.paused`) is the first user; nothing else
 * in the schema is a good home for a flag that isn't scoped to one site.
 */
model OperatorSetting {
  key       String   @id
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OperatorAuditEvent {
  id        String   @id @default(cuid())
  type      String
  actor     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  type      String
  actor     String?
  metadata  Json?
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

model OperatorAlert {
  id                 String              @id @default(cuid())
  fingerprint        String              @unique
  kind               OperatorAlertKind
  status             OperatorAlertStatus @default(PENDING)
  title              String
  message            String
  context            Json?
  occurrenceCount    Int                 @default(1)
  attempts           Int                 @default(0)
  firstOccurredAt    DateTime            @default(now())
  lastOccurredAt     DateTime            @default(now())
  nextAttemptAt      DateTime            @default(now())
  deliveryLeaseUntil DateTime?
  deliveryLeaseToken String?
  deliveredAt        DateTime?
  lastFailureCode    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([kind, lastOccurredAt])
}

model BookingRequest {
  id          String               @id @default(cuid())
  siteId      String
  site        Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  requestedAt DateTime?
  partySize   Int?
  notes       String?              @db.Text
  status      BookingRequestStatus @default(NEW)
  notifiedAt  DateTime?
  contactedAt DateTime?
  closedAt    DateTime?
  source      String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([siteId, status, createdAt])
}

model AnalyticsEvent {
  id         String             @id @db.Uuid
  visitId    String             @db.Uuid
  type       AnalyticsEventType
  siteId     String
  site       Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  occurredAt DateTime           @default(now())

  @@index([siteId, occurredAt, type])
  @@index([occurredAt])
}

model SourceMonitorState {
  siteId          String    @id
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  cadenceDays     Int
  nextRunAt       DateTime
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  lastFailureCode String?
  lastRunId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([nextRunAt])
}

model SourceMonitorRun {
  id                      String                    @id @default(cuid())
  idempotencyKey          String                    @unique
  scheduledFor            DateTime
  status                  SourceMonitorRunStatus    @default(QUEUED)
  workflowRunId           String?                   @unique
  startedAt               DateTime?
  completedAt             DateTime?
  errorCode               String?
  checkedSourceCount      Int                       @default(0)
  failedSourceCount       Int                       @default(0)
  suggestionCount         Int                       @default(0)
  notificationSentAt      DateTime?
  notificationFailureCode String?
  siteId                  String
  site                    Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  suggestions             SourceMonitorSuggestion[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([siteId, scheduledFor])
  @@index([status, createdAt])
}

model SourceMonitorSuggestion {
  id             String                        @id @default(cuid())
  fingerprint    String
  field          SourceMonitorSuggestionField
  path           String
  currentValue   Json
  suggestedValue Json
  editedValue    Json?
  evidence       Json
  status         SourceMonitorSuggestionStatus @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?
  runId          String
  run            SourceMonitorRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site                          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@unique([runId, fingerprint])
  @@index([siteId, status, createdAt])
}
