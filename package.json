{
  "name": "cornershopdev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bunx --bun prisma generate && node node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "design:lint": "designmd lint DESIGN.md && designmd lint docs/brand/cornershopdev/DESIGN.md",
    "test": "bun test --isolate",
    "test:e2e:first-customer": "playwright test tests/e2e/first-customer.pw.ts",
    "deps:update": "bunx npm-check-updates@latest -u --packageManager bun --deep --reject typescript,eslint && bun install",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "verify:brand-fonts": "bun scripts/verify-brand-fonts.mjs",
    "lighthouse:assemble": "rm -rf .next/standalone/public .next/standalone/.next/static && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "lighthouse:serve": "bun run lighthouse:assemble && PORT=4173 HOSTNAME=127.0.0.1 PLATFORM_HOSTNAMES=127.0.0.1 node .next/standalone/server.js 2>&1 | tee .next/lighthouse-server.log",
    "db:migrate:status": "bunx --bun prisma migrate status",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "operator:grant-superadmin": "bun scripts/grant-superadmin.ts",
    "operator:import:le-petit-meunier": "bun scripts/import-le-petit-meunier.ts",
    "operator:import:reviewed-drafts": "bun scripts/import-reviewed-drafts.ts",
    "operator:verify-environment-isolation": "bun scripts/verify-environment-isolation.ts",
    "operator:verify-image-storage": "bun scripts/verify-image-storage-roundtrip.ts",
    "operator:verify-first-customer": "bun scripts/verify-first-customer-production.ts",
    "operator:sign-first-customer-evidence": "bun scripts/sign-first-customer-evidence.ts",
    "operator:preflight-stripe": "bun scripts/preflight-stripe-billing.ts",
    "operator:preflight-first-customer-migration": "bun scripts/preflight-first-customer-migration.ts",
    "leads:discover": "bun scripts/discover-leads.ts",
    "operator:dispatch-alerts": "bun scripts/dispatch-operator-alerts.ts",
    "operator:dispatch-inbound-forwards": "bun scripts/dispatch-inbound-forwards.ts",
    "operator:monitor-public-site": "bun scripts/monitor-public-site.ts",
    "operator:preflight-outreach": "bun scripts/preflight-outreach.ts",
    "operator:preflight-platform-edge": "bun scripts/preflight-platform-edge.ts",
    "operator:article-rollout": "bun scripts/article-rollout.ts",
    "workflow:migrate": "bun node_modules/@workflow/world-postgres/bin/setup.js",
    "postinstall": "bunx --bun prisma generate",
    "operator:import:servizo": "bun scripts/import-servizo.ts",
    "operator:claim:servizo": "bun scripts/issue-servizo-claim-invitation.ts",
    "audit:dependencies": "bun scripts/audit-dependencies.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/prisma-adapter": "^1.7.5",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@workflow/world-postgres": "^4.3.7",
    "ai": "^7",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^6.2.1",
    "resend": "^6.28.1",
    "sharp": "^0.35.4",
    "shadcn": "^4.21.0",
    "stripe": "^22.6.2",
    "svix": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "8.11.0",
    "workflow": "^4.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@next/env": "16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "1.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "lighthouse": "13.5.0",
    "prisma": "^7.10.0",
    "puppeteer-core": "25.12.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "sharp": "^0.35.3",
    "fast-uri": "3.1.7",
    "mysql2": "3.24.3",
    "qs": "6.16.0"
  },
  "patchedDependencies": {
    "@workflow/core@4.8.5": "patches/@workflow%2Fcore@4.8.5.patch",
    "@workflow/world-local@4.4.0": "patches/@workflow%2Fworld-local@4.4.0.patch",
    "@workflow/world-vercel@4.7.1": "patches/@workflow%2Fworld-vercel@4.7.1.patch"
  }
}
